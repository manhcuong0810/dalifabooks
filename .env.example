# ══════════════════════════════════════════════════════════════════
# DalifaBooks — Environment Variables Example
# Copy file này thành .env và điền giá trị thật.
# KHÔNG commit file .env vào git.
# ══════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://dalifabooks:changeme@localhost:5432/dalifabooks_dev"

# ── Backend (NestJS) ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT secret — đổi thành chuỗi ngẫu nhiên dài >=32 ký tự trên production
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# URLs được phép CORS
STOREFRONT_URL=http://localhost:3000
CMS_URL=http://localhost:3001

# Cookie session
SESSION_SECRET=CHANGE_ME_BEFORE_PRODUCTION
SESSION_SECURE=false          # true trên production (HTTPS)
SESSION_SAME_SITE=lax

# MFA — secret mã hóa TOTP (AES-256-GCM key, 32 bytes hex)
MFA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_HERE_00000000000000000000000000000000

# ── Frontend Storefront ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── CMS ──────────────────────────────────────────────────────────
# (cùng NEXT_PUBLIC_API_URL — CMS cũng gọi backend)

# ── Object Storage (ảnh/media) ────────────────────────────────────
# Điền sau khi chốt provider (S3 / R2 / GCS / MinIO)
STORAGE_PROVIDER=local        # local | s3 | r2
STORAGE_BUCKET=dalifabooks-media
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_PUBLIC_URL=http://localhost:9000/dalifabooks-media

# ── Email ────────────────────────────────────────────────────────
# Điền sau khi chốt provider (SMTP / SES / Resend / SendGrid)
EMAIL_PROVIDER=smtp            # smtp | ses | resend
EMAIL_FROM="DalifaBooks <noreply@dalifabooks.vn>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# RESEND_API_KEY=

# ── Redis (optional — cho rate limit / idempotency cache) ─────────
# REDIS_URL=redis://localhost:6379

# ── Worker ───────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=5000
WORKER_OUTBOX_BATCH_SIZE=20
WORKER_OUTBOX_LOCK_DURATION_MS=60000

# ── Monitoring (optional) ────────────────────────────────────────
# SENTRY_DSN=
# LOG_LEVEL=info
