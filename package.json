{
  "name": "dalifabooks",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "cms",
    "backend",
    "db",
    "shared",
    "worker"
  ],
  "scripts": {
    "dev:frontend": "yarn workspace @dalifabooks/frontend dev",
    "dev:cms": "yarn workspace @dalifabooks/cms dev",
    "dev:backend": "yarn workspace @dalifabooks/backend start:dev",
    "dev:worker": "yarn workspace @dalifabooks/worker start:dev",
    "build": "yarn workspaces run build",
    "db:generate": "yarn workspace @dalifabooks/db generate",
    "db:migrate": "yarn workspace @dalifabooks/db migrate:dev",
    "db:studio": "yarn workspace @dalifabooks/db studio",
    "lint": "yarn workspaces run lint",
    "typecheck": "yarn workspaces run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  }
}
